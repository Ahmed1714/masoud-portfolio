<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EnglishMaster" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EnglishMaster.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D1B1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_english_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.EnglishMaster</item>
    </style>
</resources>
